#!/usr/bin/env python3
"""Repository-local development provisioning. Never emits credential values."""
import argparse, hashlib, json, os, pathlib, re, shutil, stat, subprocess, sys, tempfile

ROOT = pathlib.Path(__file__).resolve().parent.parent
SCHEMA = ROOT / '.dev-secrets.json'
MARKER = '# Generated by scripts/dev-secrets'
class SafeError(Exception): pass

def fail(message): raise SafeError(message)
def run(args, **kw):
    return subprocess.run(args, stdout=subprocess.PIPE, stderr=subprocess.PIPE, **kw)
def git(*args): return run(['git', '-C', str(ROOT), *args])

def parse(text):
    """Parse dotenv without executing shell code. Return values and duplicate names."""
    values, duplicates = {}, []
    lines = iter(text.replace('\r\n', '\n').splitlines())
    for line in lines:
        if not line.strip() or line.lstrip().startswith('#'): continue
        match = re.match(r'^\s*(?:export\s+)?([A-Za-z_][A-Za-z0-9_]*)\s*=\s*(.*)$', line)
        if not match: fail('Unsupported environment syntax; inspect locally without printing values.')
        key, raw = match.groups()
        if raw.startswith(('"', "'", '`')):
            quote = raw[0]
            while True:
                end = next((i for i in range(1,len(raw)) if raw[i] == quote and (i == 0 or raw[i-1] != '\\')), None)
                if end is not None: break
                try: raw += '\n' + next(lines)
                except StopIteration: fail('Unterminated environment assignment.')
            tail = raw[end+1:].strip()
            if tail and not tail.startswith('#'): fail('Unsupported trailing environment syntax.')
            value = raw[1:end]
            if quote == '"': value = value.replace('\\n', '\n').replace('\\r','\r')
        else: value = raw.split('#',1)[0].strip()
        if key in values: duplicates.append(key)
        values[key] = value
    return values, sorted(set(duplicates))

def load_schema():
    try: schema = json.loads(SCHEMA.read_text())
    except Exception: fail('Missing or invalid .dev-secrets.json.')
    if schema.get('version') != 1 or not isinstance(schema.get('profiles'), dict): fail('Unsupported schema.')
    for name, profile in schema['profiles'].items():
        if not re.fullmatch(r'[a-z0-9-]+', name): fail('Invalid profile name.')
        targets = profile.get('files', [])
        if not isinstance(targets,list) or not targets: fail('Profile has no environment file definitions.')
        seen = set()
        for file in targets:
            rel = pathlib.PurePosixPath(file['target'])
            if rel.is_absolute() or '..' in rel.parts or str(rel) in seen: fail('Unsafe or duplicate target path.')
            seen.add(str(rel))
            if not isinstance(file.get('variables'),dict): fail('Invalid variables schema.')
            for key, definition in file['variables'].items():
                if not re.fullmatch(r'[A-Za-z_][A-Za-z0-9_]*', key): fail('Invalid variable name.')
                kind = definition.get('kind')
                if kind == 'secret':
                    if not re.fullmatch(r'op://[^/\r\n]+/[^/\r\n]+/[^/\r\n]+', definition.get('reference','')): fail('Malformed secret reference for '+key+'.')
                    if 'value' in definition: fail('Secret schema cannot contain a literal value.')
                elif kind in ('config','public','fixture'):
                    if not isinstance(definition.get('value'), str): fail('Invalid configuration for '+key+'.')
                elif kind == 'missing':
                    if 'value' in definition: fail('Missing secret cannot contain a value.')
                else: fail('Unclassified variable '+key+'.')
    return schema

def digest(profile): return hashlib.sha256(json.dumps(profile, sort_keys=True).encode()).hexdigest()
def target_path(relative):
    path = ROOT / relative
    for parent in [path, *path.parents]:
        if parent == ROOT: break
        if parent.is_symlink(): fail('Unsafe symlink in environment destination.')
    if not path.parent.is_dir(): fail('Environment parent directory is missing.')
    return path

def snapshot(path):
    try: info = path.lstat()
    except FileNotFoundError: return None
    if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid(): fail('Environment must be a regular file owned by your user.')
    return (info.st_dev, info.st_ino, stat.S_IMODE(info.st_mode), path.read_bytes())

def safety(relative):
    top = git('rev-parse','--show-toplevel')
    if top.returncode or pathlib.Path(top.stdout.decode().strip()).resolve() != ROOT: fail('Use this script in its own Git checkout.')
    if git('ls-files','--',relative,'.dev-secrets.lock','.dev-secrets-tmp-*').stdout: fail('Environment or temporary paths are tracked by Git.')
    for name in (relative,'.dev-secrets.lock/check','.dev-secrets-tmp-check/check'):
        if git('check-ignore','--quiet','--',name).returncode: fail('Environment and private temporary paths must be gitignored.')

def inspect(profile):
    result = {'ok':profile.get('enabled',True),'profile_enabled':profile.get('enabled',True),'files':[]}
    for definition in profile['files']:
        relative = definition['target']; expected = definition['variables']; issues = []; actual = {}; duplicates = []
        entry = {'target':relative,'issues':issues,'missing':[],'unknown':[],'duplicates':[],'unresolved':[], 'managed':False}
        result['files'].append(entry)
        try: safety(relative)
        except SafeError: issues.append('git-protection')
        try:
            path = target_path(relative); current = snapshot(path)
            if current is None: issues.append('missing-file')
            else:
                if current[2] != 0o600: issues.append('permissions-not-0600')
                text = current[3].decode(); entry['managed'] = text.startswith(MARKER+'\n')
                if not entry['managed']: issues.append('unmanaged-file')
                elif '# Schema: '+digest(profile)+'\n' not in text: issues.append('schema-drift')
                actual, duplicates = parse(text)
                entry['unresolved'] = sorted(k for k,v in actual.items() if 'op://' in v)
        except SafeError: issues.append('unsafe-file-or-syntax')
        except Exception: issues.append('unreadable-file')
        entry['missing'] = sorted(set(expected)-set(actual)); entry['unknown'] = sorted(set(actual)-set(expected)); entry['duplicates'] = duplicates
        entry['unconfigured'] = sorted(k for k,v in expected.items() if v['kind']=='missing')
        if issues or any(entry[k] for k in ('missing','unknown','duplicates','unresolved','unconfigured')): result['ok']=False
    return result

def resolve(reference, cache):
    _, vault, item, field = reference.split('/')[-4:]
    identity=(vault,item)
    if identity not in cache:
        try: result=run(['op','item','get',item,'--vault',vault,'--format','json'],stdin=subprocess.DEVNULL,timeout=30)
        except Exception: fail('1Password unavailable or authorization timed out. Working files preserved; authorize once and retry deliberately.')
        if result.returncode: fail('1Password resolution failed. Working files preserved; raw diagnostics withheld.')
        try: cache[identity]=json.loads(result.stdout)
        except Exception: fail('Invalid 1Password response.')
    fields=cache[identity].get('fields',[])
    matching=[f for f in fields if f.get('id')==field or f.get('label')==field]
    if len(matching)!=1 or not matching[0].get('value'): fail('Canonical field missing or ambiguous. Working files preserved.')
    return matching[0]['value']

def encode(value, loader):
    if '\0' in value or '\r' in value: fail('Value is not safely representable in dotenv.')
    if loader in ('next','vite'): value=value.replace('$','\\$')
    elif '${' in value: fail('Interpolation-bearing value needs application-specific validation.')
    if "'" not in value: return "'"+value+"'"
    if '"' not in value and not re.search(r'\\[nr]',value): return '"'+value+'"'
    fail('Value needs application-specific quoting; original file preserved.')

def validate_loader(directory, definition, expected):
    loader=definition.get('loader','dotenv'); target=definition['target']
    if loader in ('next','vite','dotenv-node'):
        # Use installed application parsers; values are sent through protected stdin.
        if loader=='next':
            code="const fs=require('fs');const path=require('path');const x=JSON.parse(fs.readFileSync(0,'utf8'));const m=require(require.resolve('@next/env',{paths:[x.root]}));for(const k of Object.keys(x.expected))delete process.env[k];const e=m.loadEnvConfig(x.dir,true,{info(){},error(){}},true).combinedEnv;if(Object.keys(x.expected).some(k=>e[k]!==x.expected[k]))process.exit(1);"
        else:
            code="const fs=require('fs');const x=JSON.parse(fs.readFileSync(0,'utf8'));const d=require(require.resolve('dotenv',{paths:[x.root]}));let e=d.parse(fs.readFileSync(x.file));if(x.loader==='vite'){const ex=require(require.resolve('dotenv-expand',{paths:[x.root]}));e=ex.expand({parsed:e,processEnv:{}}).parsed;}if(Object.keys(x.expected).some(k=>e[k]!==x.expected[k]))process.exit(1);"
        payload={'root':str(ROOT / definition.get('module_root','.')),'dir':str(directory),'file':str(directory/pathlib.Path(target).name),'expected':expected,'loader':loader}
        z=run(['node','-e',code],input=json.dumps(payload).encode(),timeout=20)
        if z.returncode: fail('Application dotenv round-trip failed or parser dependencies missing. Install dependencies first; working files preserved.')
    else:
        observed,_=parse((directory/pathlib.Path(target).name).read_text())
        if observed!=expected: fail('Dotenv round-trip failed; working files preserved.')
        if loader=='python':
            executable=ROOT/definition.get('python','.venv/bin/python')
            if not executable.exists(): executable=pathlib.Path(sys.executable)
            code="import sys,json;from dotenv import dotenv_values;x=json.load(sys.stdin);v=dict(dotenv_values(x['file'],interpolate=False));sys.exit(0 if v==x['expected'] else 1)"
            z=run([str(executable),'-c',code],input=json.dumps({'file':str(directory/pathlib.Path(target).name),'expected':expected}).encode(),timeout=20)
            if z.returncode: fail('Python dotenv round-trip failed or python-dotenv missing. Working files preserved.')

def provision(command, profile):
    if not profile.get('enabled',True): fail('Profile disabled pending scope/classification review; see docs/development-secrets.md.')
    if any(v['kind']=='missing' for f in profile['files'] for v in f['variables'].values()): fail('Profile has missing or unclassified fields; canonical setup is incomplete.')
    os.umask(0o077); lock=ROOT/'.dev-secrets.lock'; locked=False; temp=None
    try:
        try: lock.mkdir(mode=0o700); locked=True
        except FileExistsError: fail('Another provisioner is active or a stale lock needs review.')
        before={}
        for definition in profile['files']:
            relative=definition['target']; safety(relative); path=target_path(relative); current=snapshot(path); before[relative]=current
            if command=='provision' and current is not None: fail('Provision never overwrites an existing environment file.')
            if command=='refresh':
                if current is None or current[2]!=0o600 or not current[3].startswith((MARKER+'\n').encode()): fail('Refresh requires a managed owner-only file; unmanaged legacy files are preserved.')
                actual,dups=parse(current[3].decode())
                if set(actual)-set(definition['variables']) or dups: fail('Unknown or duplicate local variables require classification before refresh.')
        temp=pathlib.Path(tempfile.mkdtemp(prefix='.dev-secrets-tmp-',dir=ROOT)); cache={}; candidates={}
        for index,definition in enumerate(profile['files']):
            directory=temp/str(index); directory.mkdir(mode=0o700); expected={}
            for key, variable in definition['variables'].items():
                value=resolve(variable['reference'],cache) if variable['kind']=='secret' else variable['value']
                if 'op://' in value: fail('Unresolved reference in generated environment.')
                expected[key]=value
            text=MARKER+'\n# Schema: '+digest(profile)+'\n# Disposable working copy; refresh with scripts/dev-secrets.\n'
            text+='\n'.join(k+'='+encode(v,definition.get('loader','dotenv')) for k,v in expected.items())+'\n'
            candidate=directory/pathlib.Path(definition['target']).name
            candidate.write_text(text); candidate.chmod(0o600); validate_loader(directory,definition,expected); candidates[definition['target']]=candidate
        for relative,current in before.items():
            safety(relative)
            if snapshot(target_path(relative))!=current: fail('Environment changed concurrently; working files preserved.')
        # Each replacement is atomic. All candidates validate before any replacement.
        for relative,candidate in candidates.items():
            if command=='provision': os.link(candidate,target_path(relative))
            else: os.replace(candidate,target_path(relative))
        print('Development environment '+command+' completed. No values displayed.')
    finally:
        if temp: shutil.rmtree(temp)
        if locked: lock.rmdir()

def main():
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument('command',choices=['provision','refresh','status']); parser.add_argument('--profile'); parser.add_argument('--json',action='store_true')
    args=parser.parse_args(); schema=load_schema(); name=args.profile or schema.get('default'); profile=schema['profiles'].get(name)
    if profile is None: fail('Select a configured profile with --profile.')
    if args.command=='status':
        result=inspect(profile); result['profile']=name
        if args.json: print(json.dumps(result,sort_keys=True))
        else:
            print('Profile '+name+': '+('OK' if result['ok'] else 'review needed'))
            for entry in result['files']:
                print(entry['target']+': '+json.dumps(entry,sort_keys=True))
        return 0 if result['ok'] else 2
    if args.json: fail('--json is supported for offline status only.')
    provision(args.command,profile); return 0

if __name__=='__main__':
    try: sys.exit(main())
    except SafeError as error: print(str(error),file=sys.stderr); sys.exit(1)
    except Exception: print('Operation failed safely. Credential diagnostics withheld; inspect local setup.',file=sys.stderr); sys.exit(1)
