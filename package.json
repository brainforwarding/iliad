{
  "name": "iliad",
  "productName": "Iliad MD",
  "version": "0.3.2",
  "private": true,
  "description": "A local-first Markdown writing workspace.",
  "license": "MIT",
  "author": "Sebastián Marambio",
  "repository": {
    "type": "git",
    "url": "https://github.com/brainforwarding/iliad.git"
  },
  "homepage": "https://iliad.md",
  "main": "dist-electron/main.js",
  "bin": {
    "iliad": "./bin/iliad.mjs"
  },
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1 --port 5173 --strictPort\" \"wait-on tcp:5173 && tsc -p electron/tsconfig.json --watch --preserveWatchOutput\" \"wait-on tcp:5173 dist-electron/main.js && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "tsc -b && vite build && tsc -p electron/tsconfig.json",
    "package": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --dir",
    "dist": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder",
    "dist:mac": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac",
    "dist:win": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win",
    "dist:linux": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --linux",
    "dist:mac:signed": "npm run build && electron-builder --mac",
    "preview": "vite preview --host 127.0.0.1",
    "release:refresh-update-metadata": "node scripts/refreshMacUpdateMetadata.mjs",
    "release:verify-update-metadata": "node scripts/verifyUpdateMetadata.mjs",
    "release:update-homebrew-cask": "node scripts/updateHomebrewCask.mjs",
    "test": "vitest run",
    "typecheck": "tsc -b && tsc -p electron/tsconfig.json --noEmit",
    "lint:css": "stylelint \"src/styles/**/*.css\"",
    "benchmark:autocomplete": "vite-node scripts/benchmarkAutocomplete.ts --",
    "dev:fake-ai-proxy": "vite-node scripts/devFakeAiProxy.ts --"
  },
  "dependencies": {
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-markdown": "^6.3.4",
    "@codemirror/language": "^6.11.3",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.5",
    "@lezer/highlight": "^1.2.1",
    "@uiw/codemirror-extensions-basic-setup": "^4.25.11",
    "harper.js": "^2.4.0",
    "katex": "^0.16.47",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "stylelint": "^17.12.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vite-node": "^3.2.4",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "md.iliad.app",
    "productName": "Iliad MD",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "build/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin"
      },
      {
        "from": "resources/skill",
        "to": "skill"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true,
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Office",
      "target": [
        "AppImage"
      ]
    },
    "extraMetadata": {
      "main": "dist-electron/main.js"
    }
  }
}
