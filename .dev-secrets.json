{
  "version": 1,
  "default": "env-local",
  "profiles": {
    "env-local": {
      "enabled": true,
      "files": [
        {
          "target": ".env.local",
          "loader": "dotenv-node",
          "module_root": ".",
          "variables": {
            "GROQ_API_KEY": {
              "kind": "secret",
              "reference": "op://Sebastian Work/iliad-env-local-development/GROQ_API_KEY"
            },
            "ILIAD_PROXY_SIGNING_KID": {
              "kind": "config",
              "value": "k2026a"
            },
            "ILIAD_PROXY_SIGNING_KEY": {
              "kind": "secret",
              "reference": "op://Sebastian Work/iliad-env-local-development/ILIAD_PROXY_SIGNING_KEY"
            },
            "ILIAD_PROXY_IP_HASH_KEY": {
              "kind": "secret",
              "reference": "op://Sebastian Work/iliad-env-local-development/ILIAD_PROXY_IP_HASH_KEY"
            },
            "ILIAD_PROXY_ADMIN_TOKEN": {
              "kind": "secret",
              "reference": "op://Sebastian Work/iliad-env-local-development/ILIAD_PROXY_ADMIN_TOKEN"
            },
            "CLOUDFLARE_ANALYTICS_API_TOKEN": {
              "kind": "secret",
              "reference": "op://Sebastian Work/iliad-env-local-development/CLOUDFLARE_ANALYTICS_API_TOKEN"
            }
          }
        }
      ]
    }
  }
}
